<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controles="using:Tamagotchi.Controles"
             x:Class="Tamagotchi.Vistas.CocinaView"
             Width="1280" Height="720">
    <Canvas Width="1280" Height="720">

        <Image x:Name="FondoDia" Source="avares://Tamagotchi/Assets/Escenario/CocinaFondoDia.png"
               Width="1280" Height="720" Canvas.Left="0" Canvas.Top="0" />
        <Image x:Name="FondoNoche" Source="avares://Tamagotchi/Assets/Escenario/CocinaFondoNoche.png"
               Width="1280" Height="720" Canvas.Left="0" Canvas.Top="0" IsVisible="False" />

        <Image x:Name="ImagenCocina" Source="avares://Tamagotchi/Assets/Escenario/Cocina.png"
               Width="1280" Height="720" Canvas.Left="0" Canvas.Top="0"
               Cursor="Hand" PointerPressed="Fondo_PointerPressed" />

        <controles:MascotaView x:Name="Mascota" Canvas.Left="60" Canvas.Top="280" />

        <Rectangle Canvas.Left="445" Canvas.Top="395" Width="320" Height="190"
                   Fill="Transparent" Cursor="Hand"
                   PointerPressed="Mesa_PointerPressed" ToolTip.Tip="Comer" />

        <Rectangle Canvas.Left="450" Canvas.Top="130" Width="185" Height="235"
                   Fill="Transparent" Cursor="Hand"
                   PointerPressed="Puerta_PointerPressed" ToolTip.Tip="Ir al mapa" />

        <controles:PanelEstadisticas Canvas.Left="510" Canvas.Top="10" />

    </Canvas>
</UserControl>
