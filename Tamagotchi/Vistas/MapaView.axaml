<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controles="using:Tamagotchi.Controles"
             x:Class="Tamagotchi.Vistas.MapaView"
             Width="1280" Height="720">
    <Canvas Width="1280" Height="720">

        <Image Source="avares://Tamagotchi/Assets/Escenario/Mapa.png"
               Width="1280" Height="720" Canvas.Left="0" Canvas.Top="0" />

        <Rectangle Canvas.Left="55" Canvas.Top="245" Width="445" Height="140"
                   Fill="Transparent" Cursor="Hand" PointerPressed="Habitacion_PointerPressed" />

        <Rectangle Canvas.Left="420" Canvas.Top="110" Width="405" Height="105"
                   Fill="Transparent" Cursor="Hand" PointerPressed="Cocina_PointerPressed" />

        <Rectangle Canvas.Left="785" Canvas.Top="240" Width="360" Height="135"
                   Fill="Transparent" Cursor="Hand" PointerPressed="Parque_PointerPressed" />

        <Rectangle Canvas.Left="460" Canvas.Top="405" Width="325" Height="155"
                   Fill="Transparent" Cursor="Hand" PointerPressed="Bano_PointerPressed" />

        <controles:PanelEstadisticas Canvas.Left="510" Canvas.Top="595" />

        <!-- Guarda y vuelve a la pantalla de selección (para cambiar de
             pingüino o de usuario) -->
        <StackPanel Canvas.Left="20" Canvas.Top="20" Spacing="6">
            <Button x:Name="BotonMenu" Content="🏠 Guardar y salir al menú"
                    Click="Menu_Click" />
            <TextBlock x:Name="TextoMenu" Foreground="White" Background="#CC1B1B2E"
                       Padding="8,4" MaxWidth="320" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>

    </Canvas>
</UserControl>
