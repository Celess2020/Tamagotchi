<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tamagotchi.Vistas.FinalView"
             Width="1280" Height="720">
    <Canvas Width="1280" Height="720">

        <!-- Escena final: el pingüino ya adulto -->
        <Image Source="avares://Tamagotchi/Assets/Escenario/Final.png"
               Width="1280" Height="720" Canvas.Left="0" Canvas.Top="0" />

        <!-- Cartel con la leyenda, abajo de todo para no tapar el dibujo. -->
        <Border Canvas.Left="140" Canvas.Top="560" Width="1000"
                Background="#CC1B1B2E" CornerRadius="16" Padding="24,16">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="¡Felicidades!"
                           Foreground="White" FontWeight="Bold" FontSize="34"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Cuidaste tan bien a tu pingüino que se convirtió en un adulto que tiene aura"
                           Foreground="#EEEEEE" FontSize="20"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Width="900" />

                <Button Content="🔄 Jugar de nuevo" Click="JugarDeNuevo_Click"
                        HorizontalAlignment="Center" Margin="0,10,0,0"
                        Padding="24,10" FontSize="18" />
            </StackPanel>
        </Border>

    </Canvas>
</UserControl>
