<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controles="using:Tamagotchi.Controles"
             x:Class="Tamagotchi.Vistas.BanoView"
             Width="1280" Height="720">
    <Canvas Width="1280" Height="720">

        <Image Source="avares://Tamagotchi/Assets/Escenario/Bano.png"
               Width="1280" Height="720" Canvas.Left="0" Canvas.Top="0" />

        <controles:MascotaView x:Name="Mascota" Canvas.Left="470" Canvas.Top="290" />

        <Rectangle Canvas.Left="0" Canvas.Top="395" Width="200" Height="325"
                   Fill="Transparent" Cursor="Hand"
                   PointerPressed="Inodoro_PointerPressed" ToolTip.Tip="Ir al baño" />

        <Rectangle Canvas.Left="930" Canvas.Top="0" Width="350" Height="580"
                   Fill="Transparent" Cursor="Hand"
                   PointerPressed="Ducha_PointerPressed" ToolTip.Tip="Bañarse" />

        <Rectangle Canvas.Left="0" Canvas.Top="55" Width="160" Height="335"
                   Fill="Transparent" Cursor="Hand"
                   PointerPressed="Puerta_PointerPressed" ToolTip.Tip="Ir al mapa" />

        <controles:PanelEstadisticas Canvas.Left="510" Canvas.Top="10" />

    </Canvas>
</UserControl>
