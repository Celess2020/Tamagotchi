<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tamagotchi.Vistas.InicioView"
             Width="1280" Height="720">
    <Canvas Width="1280" Height="720">

        <Image Source="avares://Tamagotchi/Assets/Escenario/Inicio.png"
               Width="1280" Height="720" Canvas.Left="0" Canvas.Top="0" />

        <!-- Zona clicable sobre el cartel "JUGAR" dibujado en la imagen -->
        <Rectangle Canvas.Left="505" Canvas.Top="497" Width="280" Height="90"
                   Fill="Transparent" Cursor="Hand"
                   PointerPressed="Jugar_PointerPressed" />

    </Canvas>
</UserControl>
